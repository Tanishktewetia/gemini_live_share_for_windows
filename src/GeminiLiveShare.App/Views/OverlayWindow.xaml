<Window x:Class="GeminiLiveShare.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini Live Share Overlay"
        Width="296"
        Height="96"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="SideToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#38101012" />
            <Setter Property="BorderBrush" Value="#38FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFB8BBC4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66585B65" />
                    <Setter Property="BorderBrush" Value="#66FFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D05B70E8" />
                    <Setter Property="BorderBrush" Value="#BFA7B4FF" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#F06B80F2" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#38101012" />
            <Setter Property="BorderBrush" Value="#38FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFD9DBE1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <Viewbox Width="14"
                                     Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="×"
                                           TextAlignment="Center" />
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66585B65" />
                    <Setter Property="BorderBrush" Value="#66FFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#8870747F" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="CollapsedShell"
                Width="72"
                Height="72"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="36"
                Cursor="Hand"
                MouseLeftButtonDown="OnCollapsedMouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FF1A1A1A" />
                    <Setter Property="BorderBrush" Value="#26FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Opacity" Value="0.80" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.55"
                                              ShadowDepth="4" Color="#FF050509" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF101012" />
                            <Setter Property="Opacity" Value="0.92" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Width="52" Height="52">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="CollapsedGradientRotation"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:6" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Ellipse>
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform x:Name="CollapsedGradientRotation"
                                                 CenterX="0.5" CenterY="0.5" />
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Offset="0" Color="#FF55D6F4" />
                            <GradientStop Offset="0.34" Color="#FF4F8DF7" />
                            <GradientStop Offset="0.68" Color="#FF8064E8" />
                            <GradientStop Offset="1" Color="#FFD25DD1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="14" Opacity="0.65" ShadowDepth="0"
                                          Color="#FF637FEF" />
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>
        </Border>

        <Grid x:Name="ExpandedShell"
              Background="Transparent"
              MouseLeftButtonDown="OnExpandedMouseLeftButtonDown">
            <Border x:Name="ExpandedPill"
                    Height="56"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    CornerRadius="28">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FF1A1A1A" />
                        <Setter Property="BorderBrush" Value="#26FFFFFF" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Opacity" Value="0.80" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.55"
                                                  ShadowDepth="4" Color="#FF050509" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ExpandedShell}" Value="True">
                                <Setter Property="Background" Value="#FF101012" />
                                <Setter Property="Opacity" Value="0.92" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Grid Width="252" Height="76"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0" IsChecked="True"
                              Style="{StaticResource SideToggleStyle}"
                              ToolTip="Toggle screen-share appearance">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets" FontSize="17"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                               Text="&#xE7F4;" />
                </ToggleButton>

                <Grid x:Name="ExpandedCenter" Grid.Column="2"
                      Width="76" Height="76" Cursor="Hand"
                      MouseLeftButtonDown="OnExpandedCenterMouseLeftButtonDown"
                      ToolTip="Collapse overlay">
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="ExpandedGradientRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:6" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Ellipse>
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <LinearGradientBrush.RelativeTransform>
                                    <RotateTransform x:Name="ExpandedGradientRotation"
                                                     CenterX="0.5" CenterY="0.5" />
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Offset="0" Color="#FF55D6F4" />
                                <GradientStop Offset="0.34" Color="#FF4F8DF7" />
                                <GradientStop Offset="0.68" Color="#FF8064E8" />
                                <GradientStop Offset="1" Color="#FFD25DD1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="16" Opacity="0.72" ShadowDepth="0"
                                              Color="#FF637FEF" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="20" Foreground="White" Text="•••" />
                </Grid>

                <ToggleButton Grid.Column="4" IsChecked="True"
                              Style="{StaticResource SideToggleStyle}"
                              ToolTip="Toggle microphone appearance">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets" FontSize="17"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                               Text="&#xE720;" />
                </ToggleButton>

                <Button x:Name="CloseButton" Grid.Column="6"
                        Click="OnCloseClick"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="Close session" />
            </Grid>
        </Grid>
    </Grid>
</Window>