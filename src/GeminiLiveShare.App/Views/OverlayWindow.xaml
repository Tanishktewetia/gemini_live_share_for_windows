<Window x:Class="GeminiLiveShare.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini Live Share Overlay"
        Width="296"
        Height="72"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="OverlayShellStyle" TargetType="Border">
            <Setter Property="Background" Value="#D9F4F7FC" />
            <Setter Property="BorderBrush" Value="#99FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      Direction="270"
                                      Opacity="0.28"
                                      ShadowDepth="3"
                                      Color="#FF26364A" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2DCE4EF" />
                    <Setter Property="BorderBrush" Value="#CCFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlaceholderStyle" TargetType="Border">
            <Setter Property="Background" Value="#26778DA8" />
            <Setter Property="BorderBrush" Value="#66778DA8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="CollapsedShell"
                Width="64"
                Height="64"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="32"
                Cursor="Hand"
                MouseLeftButtonDown="OnCollapsedMouseLeftButtonDown"
                Style="{StaticResource OverlayShellStyle}">
            <Ellipse Width="28" Height="28">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF63B3ED" />
                        <GradientStop Offset="1" Color="#FF7C83FD" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Border>

        <Border x:Name="ExpandedShell"
                Height="64"
                Margin="4"
                CornerRadius="32"
                MouseLeftButtonDown="OnExpandedMouseLeftButtonDown"
                Style="{StaticResource OverlayShellStyle}">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="36"
                        Height="32"
                        ToolTip="Screen-share control coming in Phase 5b"
                        Style="{StaticResource PlaceholderStyle}" />

                <Border x:Name="ExpandedCenter"
                        Grid.Column="2"
                        Width="64"
                        Height="48"
                        CornerRadius="24"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnExpandedCenterMouseLeftButtonDown"
                        ToolTip="Collapse overlay">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#CC63B3ED" />
                            <GradientStop Offset="1" Color="#CC7C83FD" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Foreground="White"
                               Text="•••" />
                </Border>

                <Border Grid.Column="4"
                        Width="36"
                        Height="32"
                        ToolTip="Microphone control coming in Phase 5b"
                        Style="{StaticResource PlaceholderStyle}" />

                <Button x:Name="CloseButton"
                        Grid.Column="6"
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="OnCloseClick"
                        Content="×"
                        Cursor="Hand"
                        FontSize="22"
                        Foreground="#FF334155"
                        ToolTip="Close session" />
            </Grid>
        </Border>
    </Grid>
</Window>