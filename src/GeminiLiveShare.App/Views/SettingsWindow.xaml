<Window x:Class="GeminiLiveShare.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="480"
        Height="600"
        Background="#1E1E1E"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5B8DEF" />
            <GradientStop Color="#A855F7" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ToggleOnBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#5B8DEF" />
            <GradientStop Color="#A855F7" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#181818" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#333333" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#E5484D" />
            <Setter Property="BorderBrush" Value="#8E3036" />
        </Style>
        <Style x:Key="ThemeButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ThemeBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ThemeBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeBorder" Property="Background" Value="#333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="12" />
                            <Ellipse x:Name="Handle" Width="18" Height="18" Margin="3,0,0,0"
                                     HorizontalAlignment="Left" Fill="White" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource ToggleOnBrush}" />
                                <Setter TargetName="Handle" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Handle" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2D2D2D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#181818" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="4" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="G" Foreground="White" FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="7,0,0,0" Text="Settings" Foreground="#CCCCCC" FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Width="36" Height="36" FontSize="18" Content="×" Cursor="Hand"
                        Click="OnCloseClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#999999" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E81123" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="16,16,16,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="API Key" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyText}" Text="Gemini API Key" />
                            <TextBlock Margin="0,4,0,0" Foreground="#888888" FontSize="12"
                                       Text="{Binding ApiKeySummary}" />
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <Button Width="108" Style="{StaticResource ActionButton}" Content="Update Key"
                                        Click="OnUpdateKeyClick" />
                                <Button x:Name="DeleteKeyButton" Width="108" Margin="8,0,0,0"
                                        Style="{StaticResource DeleteButton}" Content="Delete Key"
                                        Click="OnDeleteKeyClick" />
                            </StackPanel>
                            <StackPanel x:Name="ApiKeyEditor" Margin="0,12,0,0" Visibility="Collapsed">
                                <PasswordBox x:Name="ApiKeyInput" Height="32" Padding="9,0"
                                             VerticalContentAlignment="Center" Background="#2A2A2A"
                                             BorderBrush="#444444" Foreground="White" />
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <Button Width="78" Style="{StaticResource ActionButton}" Content="Save"
                                            Click="OnSaveKeyClick" />
                                    <Button Width="78" Margin="8,0,0,0" Style="{StaticResource ActionButton}"
                                            Content="Cancel" Click="OnCancelKeyClick" />
                                </StackPanel>
                            </StackPanel>
                            <Popup x:Name="DeleteConfirmationPopup" PlacementTarget="{Binding ElementName=DeleteKeyButton}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Margin="0,6,0,0" Padding="12" Width="210" Background="#2A2A2A"
                                        BorderBrush="#444444" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}" Text="Delete the saved API key?" />
                                        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button Width="48" Style="{StaticResource ActionButton}" Content="No"
                                                    Click="OnCancelDeleteClick" />
                                            <Button Width="48" Margin="8,0,0,0" Style="{StaticResource DeleteButton}"
                                                    Content="Yes" Click="OnConfirmDeleteClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Privacy &amp; Filtering" />
                            <Grid Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource BodyText}" Text="Sensitive Content Filtering"
                                           VerticalAlignment="Center" />
                                <ToggleButton HorizontalAlignment="Right" Style="{StaticResource SwitchStyle}"
                                              IsChecked="{Binding IsSensitiveContentFilteringEnabled, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E5484D" />
                                        <Setter Property="Text" Value="Credential blur is currently OFF — passwords and API keys visible on screen are not automatically redacted" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSensitiveContentFilteringEnabled}" Value="True">
                                                <Setter Property="Foreground" Value="#8CCB9B" />
                                                <Setter Property="Text" Value="Credential blur is currently ON — passwords and API keys visible on screen are automatically redacted" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Overlay Appearance" />
                            <TextBlock Margin="0,14,0,0" Style="{StaticResource BodyText}" Text="Overlay Theme" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <ToggleButton x:Name="LightThemeButton" Style="{StaticResource ThemeButton}"
                                              Content="Light" Click="OnLightThemeClick" />
                                <ToggleButton x:Name="DarkThemeButton" Margin="8,0,0,0" Style="{StaticResource ThemeButton}"
                                              Content="Dark" Click="OnDarkThemeClick" />
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}" Text="Overlay Position" />
                                    <TextBlock Margin="0,3,0,0" Foreground="#888888" FontSize="11"
                                               Text="{Binding OverlayPositionSummary}" />
                                </StackPanel>
                                <Button Width="158" HorizontalAlignment="Right" Style="{StaticResource ActionButton}"
                                        Content="Reset to Default Position" Click="OnResetPositionClick" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Keyboard Shortcut" />
                            <Grid Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}" Text="Global Hotkey" />
                                    <TextBlock x:Name="HotkeyDisplay" Margin="0,3,0,0" Foreground="#888888" FontSize="11" />
                                </StackPanel>
                                <Button x:Name="ChangeHotkeyButton" Width="86" HorizontalAlignment="Right"
                                        Style="{StaticResource ActionButton}" Content="Change" Click="OnChangeHotkeyClick" />
                            </Grid>
                            <TextBlock x:Name="HotkeyError" Margin="0,10,0,0" Foreground="#E5484D" FontSize="11"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Margin="16,10,16,12" Foreground="#999999" FontSize="11"
                       Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
