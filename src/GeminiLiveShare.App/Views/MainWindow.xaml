<Window x:Class="GeminiLiveShare.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini Live Share"
        Height="520"
        Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Width="170"
                    Height="36"
                    Command="{Binding StartOrStopCommand}"
                    Content="{Binding StartStopLabel}" />
            <Button Width="100"
                    Height="36"
                    Margin="12,0,0,0"
                    Command="{Binding OpenSettingsCommand}"
                    Content="Settings" />
            <Button Width="180"
                    Height="36"
                    Margin="12,0,0,0"
                    Command="{Binding ToggleMicrophoneCommand}"
                    Content="{Binding MicrophoneLabel}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="12"
                Background="#FFFFE3E3"
                BorderBrush="#FFB00020"
                BorderThickness="2"
                CornerRadius="4">
            <TextBlock FontWeight="Bold"
                       Foreground="#FF8B0015"
                       TextWrapping="Wrap"
                       Text="TEST MODE — screen content is sent WITHOUT credential blurring. Do not share passwords or sensitive data visible on screen yet." />
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,12">
            <TextBlock FontWeight="SemiBold" Text="Connection status" />
            <TextBlock Margin="0,4,0,0" Text="{Binding ConnectionStatus}" />
        </StackPanel>

        <GroupBox Grid.Row="3" Header="Session log">
            <ListBox Margin="8"
                     ItemsSource="{Binding LogEntries}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </GroupBox>
    </Grid>
</Window>
