<Window x:Class="GeminiLiveShare.App.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GeminiLiveShare.App.Converters"
        Title="GeminiLiveShare" Width="1000" Height="650" MinWidth="700" MinHeight="450"
        Background="#1E1E1E" FontFamily="Segoe UI" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown" Closing="OnWindowClosing">
    <Window.Resources>
        <c:ScaleConverter x:Key="Scale" />
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5B8DEF" /><GradientStop Color="#A855F7" Offset="1" /></LinearGradientBrush>
        <LinearGradientBrush x:Key="ToggleOnBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#5B8DEF" /><GradientStop Color="#A855F7" Offset="1" /></LinearGradientBrush>

        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding Tag}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource Flat}"><Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#999999" /><Setter Property="FontSize" Value="16" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Tag" Value="0" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A2A2A" /></Trigger></Style.Triggers></Style>
        <Style x:Key="SessionItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="56" /><Setter Property="Margin" Value="8,0,8,4" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6"><Grid><Border x:Name="Accent" Width="3" HorizontalAlignment="Left" CornerRadius="2" Visibility="Collapsed" Background="{StaticResource AccentBrush}" /><ContentPresenter /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#232323" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2D2D2D" /><Setter TargetName="Accent" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border"><Setter Property="Background" Value="#181818" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="14" /></Style>
        <Style x:Key="SettingsTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="#CCCCCC" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Bold" /></Style>
        <Style x:Key="SettingsText" TargetType="TextBlock"><Setter Property="Foreground" Value="#E0E0E0" /><Setter Property="FontSize" Value="12" /></Style>
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Height" Value="32" /><Setter Property="Padding" Value="12,0" /><Setter Property="Background" Value="#2A2A2A" /><Setter Property="Foreground" Value="White" /><Setter Property="FontSize" Value="12" /><Setter Property="Tag" Value="8" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="SettingsButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SettingsButtonBorder" Property="Background" Value="#363636" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="SettingsButtonBorder" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DeleteSettingsButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}"><Setter Property="Foreground" Value="#E5484D" /><Setter Property="BorderBrush" Value="#8E3036" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="DeleteBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DeleteBorder" Property="Background" Value="#3A2022" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ThemeButton" TargetType="ToggleButton"><Setter Property="Width" Value="76" /><Setter Property="Height" Value="32" /><Setter Property="Background" Value="#2A2A2A" /><Setter Property="Foreground" Value="#CCCCCC" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="ThemeBorder" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ThemeBorder" Property="Background" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="White" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThemeBorder" Property="Background" Value="#363636" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SwitchStyle" TargetType="ToggleButton"><Setter Property="Width" Value="44" /><Setter Property="Height" Value="24" /><Setter Property="Background" Value="#2A2A2A" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid><Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="12" /><Ellipse x:Name="Handle" Width="18" Height="18" Margin="3,0,0,0" HorizontalAlignment="Left" Fill="White" /></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource ToggleOnBrush}" /><Setter TargetName="Handle" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Handle" Property="Margin" Value="0,0,3,0" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

        <Style TargetType="ScrollBar"><Setter Property="Width" Value="8" /><Setter Property="Background" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Background="#3B3B3B" BorderThickness="0" IsTabStop="False" /></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False" /></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="8" /><Setter Property="Width" Value="Auto" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>

    <Border BorderBrush="#2D2D2D" BorderThickness="1"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#181818" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions><StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="4" Background="{StaticResource AccentBrush}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="White" Text="G" /></Border><TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#CCCCCC" Text="GeminiLiveShare" /></StackPanel><Button Grid.Column="1" Style="{StaticResource TitleButton}" Click="OnMinimizeClick" Content="−" /><Button Grid.Column="2" x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Click="OnMaximizeClick" ToolTip="Maximize"><TextBlock x:Name="MaximizeGlyph" FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE922;" /></Button><Button Grid.Column="3" Click="OnCloseClick" Content="×"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TitleButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E81123" /><Setter Property="Foreground" Value="White" /></Trigger></Style.Triggers></Style></Button.Style></Button></Grid>

        <Grid x:Name="MainLayout" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="0" MaxWidth="520" /><ColumnDefinition Width="*" MinWidth="320" /></Grid.ColumnDefinitions>
            <Grid x:Name="SidebarHost" Background="#181818">
                <Grid x:Name="HistoryPanel"><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions><TextBlock Grid.Row="0" Margin="16,0" VerticalAlignment="Center" Foreground="#999999" FontSize="12" FontWeight="SemiBold" Text="History" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" ItemContainerStyle="{StaticResource SessionItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="12,0"><Grid.ContextMenu><ContextMenu><MenuItem Header="Rename conversation" Tag="{Binding}" Click="OnRenameSessionClick" /></ContextMenu></Grid.ContextMenu><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="#E0E0E0" FontSize="13" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,4,0,0" Foreground="#888888" FontSize="11" Text="{Binding RelativeDate}" /></StackPanel><Button x:Name="DeleteSessionButton" Grid.Column="1" Width="26" Height="30" Visibility="Collapsed" Background="Transparent" Foreground="#888888" Style="{StaticResource Flat}" Tag="4" Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE74D;" /></Button><Popup IsOpen="{Binding IsDeleteConfirmationOpen}" Placement="Right" PlacementTarget="{Binding ElementName=DeleteSessionButton}" StaysOpen="False" AllowsTransparency="True"><Border Width="210" Padding="12" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Foreground="#E0E0E0" FontSize="12" Text="Delete this conversation?" /><StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal"><Button Width="48" Height="26" Background="#353535" Foreground="#CCCCCC" Style="{StaticResource Flat}" Tag="4" Content="No" Command="{Binding DataContext.CancelDeleteCommand, Source={x:Reference RootWindow}}" CommandParameter="{Binding}" /><Button Width="48" Height="26" Margin="8,0,0,0" Background="#E5484D" Foreground="White" Style="{StaticResource Flat}" Tag="4" Content="Yes" Command="{Binding DataContext.ConfirmDeleteCommand, Source={x:Reference RootWindow}}" CommandParameter="{Binding}" /></StackPanel></StackPanel></Border></Popup></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="DeleteSessionButton" Property="Visibility" Value="Visible" /></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Button Grid.Row="2" Background="Transparent" Style="{StaticResource Flat}" Tag="0" HorizontalContentAlignment="Stretch" Command="{Binding OpenSettingsCommand}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="SettingsNavBorder" Background="{TemplateBinding Background}" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0"><StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#999999" Text="&#xE713;" /><TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#CCCCCC" Text="Settings" /></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SettingsNavBorder" Property="Background" Value="#232323" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
                </Grid>

                <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="#181818" DataContext="{Binding ElementName=RootWindow, Path=SettingsViewModel}"><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Grid.Row="0" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1"><Grid><Button Width="36" Height="36" Margin="8,0,0,0" HorizontalAlignment="Left" Background="Transparent" Foreground="#999999" Style="{StaticResource Flat}" Tag="4" Click="OnBackFromSettingsClick" ToolTip="Back to history"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Text="‹" /></Button><TextBlock Margin="52,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E0" Text="Settings" /></Grid></Border>
                    <ScrollViewer Grid.Row="1" Margin="10,10,6,0" Padding="0,0,4,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                        <Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Style="{StaticResource SettingsTitle}" Text="API Key" /><TextBlock Margin="0,12,0,0" Style="{StaticResource SettingsText}" Text="Gemini API Key" /><TextBlock Margin="0,4,0,0" Foreground="#888888" FontSize="11" Text="{Binding ApiKeySummary}" TextWrapping="Wrap" /><StackPanel Margin="0,12,0,0" Orientation="Horizontal"><Button Width="100" Style="{StaticResource SettingsButton}" Content="Update Key" Click="OnUpdateKeyClick" /><Button x:Name="DeleteKeyButton" Width="96" Margin="8,0,0,0" Style="{StaticResource DeleteSettingsButton}" Content="Delete Key" Click="OnDeleteKeyClick" /></StackPanel><StackPanel x:Name="ApiKeyEditor" Margin="0,10,0,0" Visibility="Collapsed"><PasswordBox x:Name="ApiKeyInput" Height="30" Padding="8,0" VerticalContentAlignment="Center" Background="#242424" BorderBrush="#444444" Foreground="White" /><StackPanel Margin="0,8,0,0" Orientation="Horizontal"><Button Width="66" Style="{StaticResource SettingsButton}" Content="Save" Click="OnSaveKeyClick" /><Button Width="66" Margin="8,0,0,0" Style="{StaticResource SettingsButton}" Content="Cancel" Click="OnCancelKeyClick" /></StackPanel></StackPanel><Popup x:Name="DeleteConfirmationPopup" PlacementTarget="{Binding ElementName=DeleteKeyButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Margin="0,6,0,0" Padding="12" Width="210" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Style="{StaticResource SettingsText}" Text="Delete the saved API key?" /><StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal"><Button Width="48" Style="{StaticResource SettingsButton}" Content="No" Click="OnCancelDeleteClick" /><Button Width="48" Margin="8,0,0,0" Style="{StaticResource DeleteSettingsButton}" Content="Yes" Click="OnConfirmDeleteClick" /></StackPanel></StackPanel></Border></Popup></StackPanel></Border>
                        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Style="{StaticResource SettingsTitle}" Text="Privacy &amp; Filtering" /><Grid Margin="0,14,0,0"><TextBlock Style="{StaticResource SettingsText}" Text="Sensitive Content Filtering" VerticalAlignment="Center" TextWrapping="Wrap" /><ToggleButton HorizontalAlignment="Right" Style="{StaticResource SwitchStyle}" IsChecked="{Binding IsSensitiveContentFilteringEnabled, Mode=TwoWay}" /></Grid><TextBlock Margin="0,10,0,0" FontSize="10" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E5484D" /><Setter Property="Text" Value="Credential blur is OFF — passwords and API keys are not automatically redacted" /><Style.Triggers><DataTrigger Binding="{Binding IsSensitiveContentFilteringEnabled}" Value="True"><Setter Property="Foreground" Value="#8CCB9B" /><Setter Property="Text" Value="Credential blur is ON — passwords and API keys are automatically redacted" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Style="{StaticResource SettingsTitle}" Text="Overlay Appearance" /><TextBlock Margin="0,14,0,0" Style="{StaticResource SettingsText}" Text="Overlay Theme" /><StackPanel Margin="0,8,0,0" Orientation="Horizontal"><ToggleButton x:Name="LightThemeButton" Style="{StaticResource ThemeButton}" Content="Light" Click="OnLightThemeClick" /><ToggleButton x:Name="DarkThemeButton" Margin="8,0,0,0" Style="{StaticResource ThemeButton}" Content="Dark" Click="OnDarkThemeClick" /></StackPanel><TextBlock Margin="0,12,0,0" Style="{StaticResource SettingsText}" Text="Overlay Position" /><TextBlock Margin="0,3,0,0" Foreground="#888888" FontSize="11" Text="{Binding OverlayPositionSummary}" /><Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource SettingsButton}" Content="Reset Position" Click="OnResetPositionClick" /></StackPanel></Border>
                        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Style="{StaticResource SettingsTitle}" Text="Keyboard Shortcut" /><TextBlock Margin="0,14,0,0" Style="{StaticResource SettingsText}" Text="Global Hotkey" /><TextBlock x:Name="HotkeyDisplay" Margin="0,3,0,0" Foreground="#888888" FontSize="11" /><Button x:Name="ChangeHotkeyButton" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource SettingsButton}" Content="Change" Click="OnChangeHotkeyClick" /><TextBlock x:Name="HotkeyError" Margin="0,8,0,0" Foreground="#E5484D" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed" /></StackPanel></Border>
                    </StackPanel></ScrollViewer><TextBlock Grid.Row="2" Margin="14,8,14,10" Foreground="#999999" FontSize="10" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </Grid>
                <Thumb x:Name="SidebarResizeThumb" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" DragDelta="OnSidebarResizeDragDelta" ToolTip="Resize history panel" />
            </Grid>

            <Grid Grid.Column="1" Background="#1E1E1E"><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="SidebarToggleButton" Width="32" Height="32" Margin="4,0,0,0" Background="Transparent" Foreground="#999999" Style="{StaticResource Flat}" Tag="4" Click="OnSidebarToggleClick" ToolTip="Collapse history"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE700;" /></Button><TextBlock Grid.Column="1" Margin="4,0,20,0" VerticalAlignment="Center" Foreground="#999999" FontSize="12" Text="{Binding SessionHeader}" /></Grid><Grid x:Name="MessageArea" Grid.Row="1"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666666" FontSize="14" Text="Start talking to Gemini to begin"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasMessages}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" Padding="24,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasMessages}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ListBox.Style><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,6" /><Setter Property="Padding" Value="0" /><Setter Property="IsHitTestVisible" Value="False" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border x:Name="MessageBubble" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, ElementName=MessageList, Converter={StaticResource Scale}, ConverterParameter=0.65}" Padding="12" Background="#2A2A2A" CornerRadius="12"><TextBlock x:Name="MessageText" FontSize="13" Foreground="#E0E0E0" Text="{Binding Text}" TextWrapping="Wrap" /></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="MessageBubble" Property="Background" Value="#2563EB" /><Setter TargetName="MessageText" Property="Foreground" Value="White" /></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate></ListBox></Grid><Border Grid.Row="2" Background="#181818" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal"><Button Width="190" Height="36" Foreground="White" FontSize="13" Tag="8" Click="OnStartNewConversationClick" Content="Start New Conversation"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Flat}"><Setter Property="Background" Value="#2AB673" /><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#32C47F" /></Trigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Border></Grid>
        </Grid>
        </Grid>
    </Border>
</Window>
