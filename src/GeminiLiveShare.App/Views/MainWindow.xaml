<Window x:Class="GeminiLiveShare.App.Views.MainWindow" x:Name="RootWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:GeminiLiveShare.App.Converters" Title="GeminiLiveShare" Width="1000" Height="650"
 MinWidth="700" MinHeight="450" Background="#1E1E1E" FontFamily="Segoe UI" WindowStyle="None"
 ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <c:ScaleConverter x:Key="Scale"/>
  <Style x:Key="Flat" TargetType="Button">
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding Tag}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource Flat}">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#999999"/><Setter Property="FontSize" Value="16"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Tag" Value="0"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A2A2A"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="SessionItem" TargetType="ListBoxItem">
   <Setter Property="Height" Value="56"/><Setter Property="Margin" Value="8,0,8,4"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="item" Background="{TemplateBinding Background}" CornerRadius="6"><Grid><Border x:Name="accent" Width="3" HorizontalAlignment="Left" CornerRadius="2" Visibility="Collapsed"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#5B8DEF"/><GradientStop Color="#A855F7" Offset="1"/></LinearGradientBrush></Border.Background></Border><ContentPresenter/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="item" Property="Background" Value="#232323"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="item" Property="Background" Value="#2D2D2D"/><Setter TargetName="accent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="#2D2D2D" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Background="#181818" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
   <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="4"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5B8DEF"/><GradientStop Color="#A855F7" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="White" Text="G"/></Border><TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#CCCCCC" Text="GeminiLiveShare"/></StackPanel>
   <Button Grid.Column="1" Style="{StaticResource TitleButton}" Click="OnMinimizeClick" Content="−"/>
   <Button Grid.Column="2" Click="OnCloseClick" Content="×"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TitleButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E81123"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Button.Style></Button>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Background="#181818"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="49"/></Grid.RowDefinitions>
    <Button Height="40" Margin="16,16,16,0" VerticalAlignment="Top" Command="{Binding NewConversationCommand}" Content="+ New Conversation" Foreground="White" FontSize="13" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag="8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Flat}"><Setter Property="Background" Value="#2A2A2A"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#333333"/></Trigger></Style.Triggers></Style></Button.Style></Button>
    <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" ItemContainerStyle="{StaticResource SessionItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Foreground="#E0E0E0" FontSize="13" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,4,0,0" Foreground="#888888" FontSize="11" Text="{Binding RelativeDate}"/></StackPanel>
      <Button x:Name="del" Grid.Column="1" Width="26" Height="30" Visibility="Collapsed" Background="Transparent" Foreground="#888888" Style="{StaticResource Flat}" Tag="4" Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE74D;"/></Button>
      <Popup IsOpen="{Binding IsDeleteConfirmationOpen}" Placement="Right" PlacementTarget="{Binding ElementName=del}" StaysOpen="False" AllowsTransparency="True"><Border Width="210" Padding="12" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Foreground="#E0E0E0" FontSize="12" Text="Delete this conversation?"/><StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal"><Button Width="48" Height="26" Background="#353535" Foreground="#CCCCCC" Style="{StaticResource Flat}" Tag="4" Content="No" Command="{Binding DataContext.CancelDeleteCommand, Source={x:Reference RootWindow}}" CommandParameter="{Binding}"/><Button Width="48" Height="26" Margin="8,0,0,0" Background="#E5484D" Foreground="White" Style="{StaticResource Flat}" Tag="4" Content="Yes" Command="{Binding DataContext.ConfirmDeleteCommand, Source={x:Reference RootWindow}}" CommandParameter="{Binding}"/></StackPanel></StackPanel></Border></Popup>
     </Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="del" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Button Grid.Row="2" Background="Transparent" Style="{StaticResource Flat}" Tag="0" HorizontalContentAlignment="Stretch" Command="{Binding OpenSettingsCommand}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="sb" Background="{TemplateBinding Background}" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0"><StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#999999" Text="&#xE713;"/><TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#CCCCCC" Text="Settings"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="sb" Property="Background" Value="#232323"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
   </Grid>
   <Grid Grid.Column="1" Background="#1E1E1E"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
    <TextBlock Margin="20,0" VerticalAlignment="Center" Foreground="#999999" FontSize="12" Text="{Binding SessionHeader}"/>
    <Grid x:Name="MessageArea" Grid.Row="1">
     <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666666" FontSize="14" Text="Start talking to Gemini to begin"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasMessages}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" Padding="24,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasMessages}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListBox.Style><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,6"/><Setter Property="Padding" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border x:Name="bubble" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, ElementName=MessageList, Converter={StaticResource Scale}, ConverterParameter=0.65}" Padding="12" Background="#2A2A2A" CornerRadius="12"><TextBlock x:Name="text" FontSize="13" Foreground="#E0E0E0" Text="{Binding Text}" TextWrapping="Wrap"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="bubble" Property="Background" Value="#2563EB"/><Setter TargetName="text" Property="Foreground" Value="White"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
    <Border Grid.Row="2" Background="#181818" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
     <Button Width="140" Height="36" Foreground="White" FontSize="13" Tag="8" Command="{Binding StartOrStopCommand}" Content="{Binding StartStopLabel}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Flat}"><Setter Property="Background" Value="#2AB673"/><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Background" Value="#E5484D"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     <Button Width="36" Height="36" Margin="12,0,0,0" Background="#2A2A2A" Foreground="#CCCCCC" Style="{StaticResource Flat}" Tag="18" Command="{Binding ToggleMicrophoneCommand}"><Grid Width="36" Height="36"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE720;"/><Line X1="10" Y1="26" X2="26" Y2="10" Stroke="White" StrokeThickness="2"><Line.Style><Style TargetType="Line"><Style.Triggers><DataTrigger Binding="{Binding IsMicrophoneOn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Line.Style></Line></Grid></Button>
    </StackPanel></Border>
   </Grid>
  </Grid>
 </Grid></Border>
</Window>