<Window x:Class="GeminiLiveShare.App.Views.RenameSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename conversation"
        Width="380"
        Height="160"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#E0E0E0">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="13" Text="Conversation title" />
        <TextBox x:Name="TitleBox"
                 Grid.Row="1"
                 Margin="0,8,0,0"
                 Padding="8,4"
                 Background="#2A2A2A"
                 BorderBrush="#4A4A4A"
                 Foreground="#FFFFFF"
                 MaxLength="80"
                 Text="" />
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="72" Height="28" Margin="0,12,8,0" Click="OnCancelClick" Content="Cancel" />
            <Button Width="72" Height="28" Margin="0,12,0,0" Click="OnSaveClick" Content="Save" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
